local ESPTab = Window:CreateTab("ESP", "eye")

local SeekerESPEnabled = false
local HiderESPEnabled = false
local SeekerColor = Color3.fromRGB(255, 60, 60)
local HiderColor = Color3.fromRGB(60, 180, 255)

local NickEnabled = false
local TracerEnabled = false
local BillboardDistanceEnabled = false
local OutlineEnabled = false
local BoxEnabled = false

local ESPObjects = {}

local function findLivingEntry(character, player)
    local living = Workspace:FindFirstChild("Living")
    if not living then return nil end
    return living:FindFirstChild(character.Name) or living:FindFirstChild(player.Name)
end

local function hasWeapon(character, player)
    local entry = findLivingEntry(character, player)
    if not entry then return false end
    return entry:FindFirstChild("Weapon", true) ~= nil
end

local function createBillboard(character, color)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = character:FindFirstChild("Head")
    billboard.Parent = character

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = character.Name
    nameLabel.TextColor3 = color
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = billboard

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Name = "InfoLabel"
    infoLabel.Size = UDim2.new(1, 0, 0.5, 0)
    infoLabel.Position = UDim2.new(0, 0, 0.5, 0)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    infoLabel.TextStrokeTransparency = 0
    infoLabel.TextScaled = true
    infoLabel.Font = Enum.Font.Gotham
    infoLabel.Parent = billboard

    return billboard, nameLabel, infoLabel
end

local function createOutline(character, color)
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Outline"
    highlight.FillTransparency = 1
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    return highlight
end

local function createBox(character, color)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local box = Instance.new("BoxHandleAdornment")
    box.Name = "ESP_Box"
    box.Adornee = hrp
    box.AlwaysOnTop = true
    box.ZIndex = 1
    box.Size = Vector3.new(4, 6, 4)
    box.Color3 = color
    box.Transparency = 0.7
    box.Parent = hrp
    return box
end

local function createTracer(color)
    local line = Drawing.new("Line")
    line.Thickness = 1.5
    line.Color = color
    line.Transparency = 1
    line.Visible = false
    return line
end

local function destroyESP(player)
    local objects = ESPObjects[player]
    if not objects then return end
    if objects.highlight then objects.highlight:Destroy() end
    if objects.billboard then objects.billboard:Destroy() end
    if objects.box then objects.box:Destroy() end
    if objects.tracer then objects.tracer:Remove() end
    ESPObjects[player] = nil
end

local function buildESP(player, character, isSeeker)
    ESPObjects[player] = {
        character = character,
        isSeeker = isSeeker,
        highlight = nil, billboard = nil, nameLabel = nil,
        infoLabel = nil, box = nil, tracer = nil,
    }
end

local function applyFeatures(player)
    local objects = ESPObjects[player]
    if not objects then return end

    local character = objects.character
    local color = objects.isSeeker and SeekerColor or HiderColor

    if OutlineEnabled and not objects.highlight then
        objects.highlight = createOutline(character, color)
    elseif not OutlineEnabled and objects.highlight then
        objects.highlight:Destroy()
        objects.highlight = nil
    end
    if objects.highlight then objects.highlight.OutlineColor = color end

    if BoxEnabled and not objects.box then
        objects.box = createBox(character, color)
    elseif not BoxEnabled and objects.box then
        objects.box:Destroy()
        objects.box = nil
    end
    if objects.box then objects.box.Color3 = color end

    local needsBillboard = NickEnabled or BillboardDistanceEnabled
    if needsBillboard and not objects.billboard then
        objects.billboard, objects.nameLabel, objects.infoLabel = createBillboard(character, color)
    elseif not needsBillboard and objects.billboard then
        objects.billboard:Destroy()
        objects.billboard = nil
        objects.nameLabel = nil
        objects.infoLabel = nil
    end
    if objects.billboard then
        objects.nameLabel.Visible = NickEnabled
        objects.nameLabel.TextColor3 = color
        objects.infoLabel.Visible = BillboardDistanceEnabled
    end

    if TracerEnabled and not objects.tracer then
        objects.tracer = createTracer(color)
    elseif not TracerEnabled and objects.tracer then
        objects.tracer:Remove()
        objects.tracer = nil
    end
    if objects.tracer then objects.tracer.Color = color end
end

local function updateVisuals()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for player, objects in pairs(ESPObjects) do
        local character = objects.character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if hrp then
            if objects.infoLabel and BillboardDistanceEnabled then
                local distance = myHrp and math.floor((myHrp.Position - hrp.Position).Magnitude) or 0
                local role = objects.isSeeker and "Seeker" or "Hider"
                objects.infoLabel.Text = role .. " | " .. distance .. "m"
            end

            if objects.tracer then
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    objects.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    objects.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                    objects.tracer.Visible = true
                else
                    objects.tracer.Visible = false
                end
            end
        end
    end
end

local function espScan()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local head = character and character:FindFirstChild("Head")

            if character and humanoid and humanoid.Health > 0 and hrp and head then
                local isSeeker = hasWeapon(character, player)
                local shouldShow = (isSeeker and SeekerESPEnabled) or (not isSeeker and HiderESPEnabled)
                local existing = ESPObjects[player]

                if shouldShow then
                    if not existing or existing.character ~= character or existing.isSeeker ~= isSeeker then
                        destroyESP(player)
                        buildESP(player, character, isSeeker)
                    end
                    applyFeatures(player)
                else
                    destroyESP(player)
                end
            else
                destroyESP(player)
            end
        end
    end

    updateVisuals()
end

task.spawn(function()
    while true do
        if SeekerESPEnabled or HiderESPEnabled then
            espScan()
        else
            for player in pairs(ESPObjects) do destroyESP(player) end
        end
        task.wait(0.1)
    end
end)

