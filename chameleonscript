local startTime = os.time()
local function formatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    return string.format("%02d:%02d:%02d", hours, minutes, secs)
end
local TimerLabel = HomeTab:CreateLabel("Running Time: 00:00:00", "clock")

local frameCount = 0
local fpsAccum = 0
RunService.Heartbeat:Connect(function(dt)
    frameCount = frameCount + 1
    fpsAccum = fpsAccum + dt
end)

task.spawn(function()
    while true do
        TimerLabel:Set("Running Time: " .. formatTime(os.time() - startTime))

        local fps = fpsAccum > 0 and math.floor(frameCount / fpsAccum) or 0
        frameCount = 0
        fpsAccum = 0
        FpsLabel:Set("FPS: " .. fps)

        local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        PingLabel:Set("Ping: " .. ping .. " ms")

        local ram = math.floor(Stats:GetTotalMemoryUsageMb())
        RamLabel:Set("RAM: " .. ram .. " MB")

        PlayersLabel:Set("Players: " .. #Players:GetPlayers())

        task.wait(1)
    end
end)

